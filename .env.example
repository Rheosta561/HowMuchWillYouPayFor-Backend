# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/howmuchwillyoupayfor

# Auth tokens (use long random values in production)
JWT_ACCESS_SECRET=change-me-to-a-32-plus-char-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=howmuchwillyoupayfor
JWT_AUDIENCE=howmuchwillyoupayfor-api
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_LEEWAY_SECONDS=10
REFRESH_IP_MAX=60

# Email OTP
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_HASH_PEPPER=change-me-to-a-random-pepper
OTP_REQUEST_IP_MAX=20
OTP_VERIFY_IP_MAX=60

# Email delivery (dev = log-only outbox; resend needs RESEND_API_KEY)
EMAIL_PROVIDER=dev
RESEND_API_KEY=
EMAIL_FROM="HowMuchWillYouPayFor <no-reply@example.com>"

# Token delivery & browser cookies (body | cookie | both)
AUTH_TOKEN_DELIVERY=body
AUTH_REFRESH_COOKIE_NAME=hmwyp_refresh
AUTH_CSRF_COOKIE_NAME=hmwyp_csrf
AUTH_CSRF_HEADER=x-csrf-token
AUTH_REFRESH_COOKIE_SAMESITE=lax
FRONTEND_ORIGINS=http://localhost:3000

# Pricing responses
RESPONSES_IP_MAX=60

# Google sign-in (required for real Google auth)
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_AUDIENCES=
GOOGLE_AUTH_IP_MAX=60

# Leaderboard snapshots (in-process node-cron refresh, default every 15 min UTC)
LEADERBOARD_MIN_RESPONSES=30
LEADERBOARD_CRON_SCHEDULE=*/15 * * * *
LEADERBOARD_TIMEZONE=UTC
LEADERBOARD_LOCK_TTL_SECONDS=300
LEADERBOARD_ENABLED=true

APP_BASE_URL=http://localhost:3000
